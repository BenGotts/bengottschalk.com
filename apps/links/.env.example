# Copy to .env.local and fill in. Never commit it.

# Turso database (shared with the MCP app). Locally, the file database made by
# `npm run db:migrate` at the repo root.
TURSO_DATABASE_URL=file:../../.data/dev.db
TURSO_AUTH_TOKEN=

# Shared with the MCP app, which sends it to /api/revalidate after editing links.
REVALIDATE_SECRET=
