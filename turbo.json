{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["YOUTUBE_API_KEY", "RESEND_API_KEY", "SEND_TO_EMAIL", "WCA_API_URL", "NEXT_PUBLIC_WCA_LIVE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {}
  }
}
