# Signing in with WCA and syncing. Leave these unset to run the timer local-only.

# Postgres (Supabase). Use the transaction pooler connection string (port 6543).
# Values starting with REPLACE_ME count as unset (sign-in stays off until they are filled in).
DATABASE_URL=

# A long random string: `openssl rand -base64 32`. Must match across production and previews.
BETTER_AUTH_SECRET=
# This deployment's URL, e.g. http://localhost:3004 (inferred on Vercel when unset).
BETTER_AUTH_URL=http://localhost:3004

# From the WCA OAuth application (worldcubeassociation.org/oauth/applications).
# Its redirect URIs: https://timer.bengottschalk.com/api/auth/callback/wca
# and http://localhost:3004/api/auth/callback/wca
WCA_CLIENT_ID=
WCA_CLIENT_SECRET=
