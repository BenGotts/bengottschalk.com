{
  "name": "@bengottschalk/timer",
  "version": "0.1.0",
  "private": true,
  "description": "timer.bengottschalk.com: a speedcubing timer with every WCA event, sessions with branches and Solve of the Day.",
  "scripts": {
    "predev": "node scripts/bundle-cubing.mjs",
    "dev": "next dev --port 3004",
    "prebuild": "node scripts/bundle-cubing.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --type-aware",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@bengottschalk/content": "*",
    "@bengottschalk/theme": "*",
    "@bengottschalk/timer-core": "*",
    "@bengottschalk/wca": "*",
    "@cubing/icons": "^3.0.5",
    "better-auth": "^1.7.27",
    "cubing": "^0.66.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.6",
    "postgres": "^3.4.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "daisyui": "^5.7.50",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.8",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "26.x"
  }
}
