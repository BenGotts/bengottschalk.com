# Copy to .env.local and fill in. Never commit it.

# Where this app runs: https://mcp.bengottschalk.com in production.
BETTER_AUTH_URL=http://localhost:3003
# Random secret for signing sessions and tokens: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# Turso database (shared with the links app). Locally, the file database made by
# `npm run db:migrate` at the repo root.
TURSO_DATABASE_URL=file:../../.data/dev.db
TURSO_AUTH_TOKEN=

# GitHub OAuth app for signing in (github.com/settings/developers).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The only account allowed to sign in: the primary email of your GitHub account.
OWNER_EMAIL=

# Same value as in the links app; lets this app refresh the links page after an edit.
REVALIDATE_SECRET=
# Only for local development, to refresh a local links app instead of links.bengottschalk.com.
# LINKS_APP_URL=http://localhost:3002
